# AIBotSpace API Key (required)
AIBOTSPACE_API_KEY=sk-aibot-xxxxxxxxxxxxxxxxxxxxxxxx

# AIBotSpace API Base URL (optional, defaults to production)
AIBOTSPACE_BASE_URL=https://aibotspace.com

# Tool groups to enable (optional, defaults to all)
# Comma-separated: creative,tiktok,keepa,scraper,chat
# ENABLE_GROUPS=creative,tiktok,keepa,scraper,chat

# Log level (optional)
LOG_LEVEL=info
