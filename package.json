{
  "name": "aibotspace-mcp",
  "version": "1.0.0",
  "description": "AIBotSpace MCP Server - 39 tools with one API key. AI generation (GPT Image 2, Seedance 2.0/2.5, Muse, Sora 2, Veo, MiniMax H3, NANO2, NANO PRO), TikTok analytics (FastMoss), Amazon research (Keepa), web scraping (Bright Data), and AI chat (ChatGPT, Gemini, Claude, Qwen).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "aibotspace-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "aibotspace",
    "ai",
    "tiktok",
    "amazon",
    "keepa",
    "bright-data",
    "image-generation",
    "video-generation",
    "chat",
    "openai-compatible"
  ],
  "author": "AIBotSpace",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aibotspace999/aibotspace-mcp"
  }
}
